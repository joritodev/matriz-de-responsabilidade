# Copie para .env.local. Sem as variáveis do Supabase o site usa o login local
# (somente fora de produção): supervisor@prazo.local / prazo-local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:4318

# Modo local (opcional)
# LOCAL_LOGIN_EMAIL=supervisor@prazo.local
# LOCAL_LOGIN_PASSWORD=prazo-local
