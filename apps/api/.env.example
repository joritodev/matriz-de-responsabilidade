# Copie para .env. Sem DATABASE_URL e SUPABASE_URL a API roda em modo local:
# banco PGlite (Postgres embutido em .data/pglite, com migração e seed) e login local.

# Pooler de TRANSAÇÃO do Supabase (painel > Connect), porta 6543
DATABASE_URL=
# Validação do token de login (supabase.auth.getClaims)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Cabeçalho x-api-key das rotas do Make (64 caracteres aleatórios: openssl rand -hex 32)
MAKE_API_KEY=prazo-local-make-key
# CORS (separe várias origens por vírgula)
WEB_ORIGIN=http://localhost:4317,http://127.0.0.1:4317
APP_TIME_ZONE=America/Fortaleza
# Só em desenvolvimento, para reproduzir as telas com o seed. Ignorado em produção.
APP_FIXED_TODAY=2026-10-20
PORT=4318

# Modo local (sem Supabase): e-mail liberado em members automaticamente
DEV_MEMBER_EMAIL=supervisor@prazo.local
# PGLITE_DATA_DIR=memory  # banco só em memória
