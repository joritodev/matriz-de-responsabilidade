# Copiar para `.env`. Nunca commitar secrets reais.
NODE_ENV=development
PROCESS_ROLE=web
LOG_LEVEL=info
TZ=America/Sao_Paulo

DATABASE_URL=postgresql://matriz:matriz@localhost:5432/matriz
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-at-least-32-chars-long

# --- WhatsApp Cloud API (WABA) ---
# Deixe false até ter credenciais, templates aprovados e opt-in dos responsáveis.
# Enquanto false: zero cobrança; envio assistido (wa.me) continua funcionando.
WHATSAPP_ENABLED=false

# Preencha depois de criar o app em developers.facebook.com (ver docs/runbooks/waba-mei-passo-a-passo.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=escolha-um-token-secreto-aleatorio
WHATSAPP_GRAPH_API_VERSION=v22.0

AI_ENABLED=false

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=123456
