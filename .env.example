# Copiar para `.env`. Nunca commitar secrets reais.
NODE_ENV=development
PROCESS_ROLE=web
LOG_LEVEL=info
TZ=America/Sao_Paulo

DATABASE_URL=postgresql://matriz:matriz@localhost:5432/matriz
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-at-least-32-chars-long

WHATSAPP_ENABLED=false
AI_ENABLED=false

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=change-me-local-only
