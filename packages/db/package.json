{
  "name": "@matriz/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "seed:demo": "tsx --env-file=../../.env scripts/seed-demo.ts",
    "seed:pdf": "tsx --env-file=../../.env scripts/seed-pdf-matrices.ts",
    "upgrade:pos-task3": "tsx --env-file=../../.env scripts/upgrade-pos-task3-deadline.ts",
    "upgrade:geral-task3": "tsx --env-file=../../.env scripts/upgrade-geral-task3-recurring.ts",
    "deadline-tick": "tsx --env-file=../../.env scripts/run-deadline-tick.ts",
    "fix-due-today": "tsx --env-file=../../.env scripts/fix-due-today-to-date.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matriz/config": "*",
    "@matriz/core": "*",
    "@matriz/shared": "*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.40.1",
    "postgres": "^3.4.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
