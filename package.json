{
  "name": "matriz-de-responsabilidade",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev -w @matriz/web",
    "dev:worker": "npm run dev -w @matriz/worker",
    "dev:all": "npx concurrently -n web,worker -c blue,green \"npm run dev -w @matriz/web\" \"npm run dev:worker\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "e2e:server": "npm run db:migrate && npm run db:seed && npm run dev -w @matriz/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @matriz/db",
    "db:migrate": "npm run migrate -w @matriz/db",
    "db:seed": "npm run seed -w @matriz/db",
    "db:seed-demo": "npm run seed:demo -w @matriz/db",
    "db:seed-pdf": "npm run seed:pdf -w @matriz/db",
    "db:upgrade-pos-task3": "npm run upgrade:pos-task3 -w @matriz/db",
    "db:upgrade-geral-task3": "npm run upgrade:geral-task3 -w @matriz/db",
    "db:deadline-tick": "npm run deadline-tick -w @matriz/db",
    "db:fix-due-today": "npm run fix-due-today -w @matriz/db",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
