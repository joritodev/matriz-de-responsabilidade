{
  "name": "matriz-de-responsabilidade",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev -w @matriz/web",
    "dev:worker": "npm run dev -w @matriz/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @matriz/db",
    "db:migrate": "npm run migrate -w @matriz/db",
    "db:seed": "npm run seed -w @matriz/db",
    "db:seed-demo": "npm run seed:demo -w @matriz/db",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
